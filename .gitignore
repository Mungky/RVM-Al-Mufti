# Local toolchain / backups (not source, not for GitHub)
.tools/
backups/

# Dependencies
node_modules/

# Build / packaging output (Electron dist, firmware compiled artifacts)
# release/ is tracked (via Git LFS for the large binary/asar) so a fresh
# clone can run run-rvm.sh without manually copying the bundle.
dist/
build/
bundle/
firmware/**/build/
firmware/builds/

# Logs
*.log

# Secrets / environment
.env
.env.*

# Python
__pycache__/
*.pyc
venv/
.venv/

# OS temp files
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# Camera-captured media (not licensed/stock assets)
*.jpg
*.jpeg
*.png
*.mp4
*.avi
*.mov
!icon.png
!assets/media/recycling-12s.webm

# Datasets
dataset/
datasets/
*.dataset/

# Personal data: RFID UID lists / transaction & raw sensor logs (test captures)
docs/rfid-standalone-results-*.json
docs/sensor-reference-isolation-*.json
docs/sensor-isolation-followup-*.json
docs/rebuilt-test-*.json
docs/basic-reference-live.json
